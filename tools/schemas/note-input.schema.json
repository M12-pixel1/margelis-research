{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:margelis-research:schema:note-input:1",
  "title": "Margelis Research note input (research/<NNN>/note.yaml)",
  "type": "object",
  "required": ["number", "version", "date", "title", "subtitle", "authors", "language", "publication_type",
               "status", "zenodo", "abstract", "keywords", "web_keywords", "license", "version_history"],
  "additionalProperties": false,
  "properties": {
    "number": {"type": "string", "pattern": "^[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 3},
    "subtitle": {"type": "string", "minLength": 3},
    "authors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["given_name", "family_name", "affiliation"],
        "properties": {
          "given_name": {"type": "string"},
          "family_name": {"type": "string"},
          "affiliation": {"type": "string"},
          "orcid": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"}
        }
      }
    },
    "language": {"type": "string", "enum": ["en", "lt"]},
    "publication_type": {"type": "string"},
    "status": {"type": "string"},
    "zenodo": {
      "type": "object", "additionalProperties": false, "required": ["upload_type", "publication_type"],
      "properties": {
        "upload_type": {"const": "publication"},
        "publication_type": {"enum": ["technicalnote", "report", "workingpaper", "preprint", "other"]}
      }
    },
    "abstract": {"type": "string", "minLength": 40},
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "web_keywords": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "spdx", "proposed", "scope", "authorized_by", "authorized_on"],
      "properties": {
        "status": {"enum": ["pending", "granted"]},
        "spdx": {"type": ["string", "null"]},
        "proposed": {"type": ["string", "null"]},
        "scope": {"type": "string"},
        "authorized_by": {"type": ["string", "null"]},
        "authorized_on": {"type": ["string", "null"]}
      },
      "if": {"properties": {"status": {"const": "granted"}}},
      "then": {"properties": {"spdx": {"type": "string"}, "authorized_by": {"type": "string"},
                              "authorized_on": {"type": "string", "format": "date"}}},
      "else": {"properties": {"spdx": {"type": "null"}}}
    },
    "locked_statements": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "version_history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["version", "date", "summary"],
        "properties": {
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "date": {"type": "string", "format": "date"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
